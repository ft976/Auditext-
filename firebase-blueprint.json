{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a registered user who can create and save TTS history.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "A record of a text-to-speech generation session.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "voice": { "type": "string" },
        "emotion": { "type": "string" },
        "language": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "voice", "emotion", "language", "provider", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and private user profiles."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "Securely stored history of TTS sessions for the specific user."
    }
  }
}
