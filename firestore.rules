rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidHistoryItem(data) {
      return data.text is string && data.text.size() <= 10000 &&
             data.voice is string && data.emotion is string &&
             data.language is string && data.provider is string &&
             data.createdAt is timestamp;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // User history
      match /history/{itemId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && isValidHistoryItem(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }
  }
}
